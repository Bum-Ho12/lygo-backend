# --- App ---
APP_ENV=local
APP_NAME=lygo-backend
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Auth ---
JWT_SECRET=change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14
MFA_REQUIRED_FOR_FIRM_ROLES=false   # MUST be true in production
TRUSTED_PROXY_HOPS=0                # set to the number of reverse proxies in front of the API so rate limits see real client IPs

# --- Database (app role must NOT own tables / no BYPASSRLS) ---
DATABASE_URL=postgresql+asyncpg://lygo_app:lygo_app@localhost:5432/lygo
DATABASE_MIGRATOR_URL=postgresql+psycopg://lygo_owner:lygo_owner@localhost:5432/lygo

# --- Queue / cache ---
REDIS_URL=redis://localhost:6379/0

# --- Lygo-managed object storage (RumptyCloud Object Storage / MinIO locally) ---
STORAGE_BACKEND=local          # local (filesystem, dev only) | s3
STORAGE_LOCAL_DIR=data/objects
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=local
STORAGE_BUCKET=lygo-local
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
# Firm bucket endpoints on private/internal addresses are always refused outside local; true = refuse locally too
STORAGE_BLOCK_PRIVATE_ENDPOINTS=false

# --- Encryption ---
MASTER_KEY=                    # base64 of 32 random bytes (python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"); required outside local
MASTER_KEY_REF=local-dev-key

# --- AI: Anthropic Claude (preferred) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_FALLBACKS=true
# --- AI (OpenAI-compatible endpoint, e.g. RumptyCloud inference; used only if ANTHROPIC_API_KEY is empty) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_CHAT=
LLM_MODEL_FAST=
# Embeddings: Voyage AI (recommended: voyage-law-2, legal retrieval, 1024 dims). Takes precedence over EMBEDDING_MODEL.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-law-2
EMBEDDING_MODEL=               # only for an OpenAI-compatible embedding endpoint (used if VOYAGE_API_KEY is empty)
EMBEDDING_DIM=1024             # must equal the chunks.embedding column; voyage-law-2 outputs exactly 1024

# --- Ingestion ---
MAX_UPLOAD_MB=50
INGEST_MODE=inline             # inline (in-process, dev) | celery
CLAMD_HOST=                    # REQUIRED outside local: uploads fail closed without a scanner
CLAMD_PORT=3310

# --- OCR ---
OCR_ENGINE=tesseract
OCR_LANGS=eng+swa
OCR_REVIEW_THRESHOLD=0.80

# --- SMS (Thrivewave) ---
THRIVEWAVE_BASE_URL=https://sms.thrivevas.com
THRIVEWAVE_API_KEY=            # API token (x-api-key); generate via identity.thrivevas.com, may expire
THRIVEWAVE_SENDER_ID=          # your registered sender ID; empty = provider default

# --- Email ---
# Outbound email via any SMTP relay (provider credentials in production; Mailpit locally: host=localhost port=1025 security=none).
# Leave SMTP_HOST empty to disable email (invitations/password resets then cannot be delivered outside local env).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls         # starttls | tls | none
EMAIL_FROM=no-reply@lygo.local # must be a domain you control with SPF/DKIM/DMARC set up
EMAIL_FROM_NAME=Lygo
FRONTEND_BASE_URL=http://localhost:3000

# --- Firm sign-up ---
FIRM_SIGNUP_MODE=review        # review (platform admin approves) | auto (instant; dev/pilot only) | closed
TERMS_VERSION=2026-11-draft    # terms + DPA version applicants accept
