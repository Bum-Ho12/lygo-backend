# --- App ---
APP_ENV=local
APP_NAME=lygo-backend
API_BASE_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO

# --- Auth ---
JWT_SECRET=change-me
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# --- Database (app role must NOT own tables / no BYPASSRLS) ---
DATABASE_URL=postgresql+asyncpg://lygo_app:lygo_app@localhost:5432/lygo
DATABASE_MIGRATOR_URL=postgresql+psycopg://lygo_owner:lygo_owner@localhost:5432/lygo

# --- Queue / cache ---
REDIS_URL=redis://localhost:6379/0

# --- Lygo-managed object storage (RumptyCloud Object Storage / MinIO locally) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=local
STORAGE_BUCKET=lygo-local
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- Encryption ---
MASTER_KEY_REF=local-dev-key

# --- AI (OpenAI-compatible endpoint, e.g. RumptyCloud inference) ---
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_CHAT=
LLM_MODEL_FAST=
EMBEDDING_MODEL=
EMBEDDING_DIM=1024

# --- OCR ---
OCR_ENGINE=tesseract
OCR_LANGS=eng+swa
OCR_REVIEW_THRESHOLD=0.80

# --- SMS (Thrivewave) ---
THRIVEWAVE_BASE_URL=
THRIVEWAVE_API_KEY=
THRIVEWAVE_SENDER_ID=
THRIVEWAVE_DLR_SECRET=

# --- Email ---
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=no-reply@lygo.local
